{
  "RouterOS": {
    "Host": "192.168.88.1",
    "SshPort": 22,
    "Username": "admin",
    "Password": "",
    "PrivateKeyPath": null,
    "PrivateKeyPassphrase": null,
    "ExpectedHostKeyFingerprint": null,
    "SshTimeoutSeconds": 30,
    "SshCommandTimeoutSeconds": 60,
    "EnableRestApi": true,
    "RestBaseUrl": null,
    "UseHttpsForRest": true,
    "RestAllowSelfSignedCert": true,
    "RestTimeoutSeconds": 30,
    "ReadOnly": true,
    "AllowArbitraryCommands": false,
    "AllowArbitraryCommandsInReadOnly": false,
    "CommandDenyList": [
      "/system reset-configuration",
      "/system shutdown",
      "/file remove",
      "/user remove"
    ],
    "DefaultPageSize": 200,
    "MaxLogEntries": 500,
    "EnableSystemTools": true,
    "EnableInterfaceTools": true,
    "EnableIpTools": true,
    "EnableFirewallTools": true,
    "EnableWirelessTools": true,
    "EnableRoutingTools": true,
    "EnableDiagnosticsTools": true,
    "EnableLogTools": true,
    "EnableManagementTools": true
  },
  "Server": {
    "Host": "0.0.0.0",
    "Port": 5100,
    "Path": "/mcp",
    "WindowsServiceName": "RouterOSMCPSharp"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/routerosmcp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ]
  }
}
