# Build output
bin/
obj/
out/
publish/
*.binlog

# Logs (Serilog rolling files)
logs/
*.log

# Local secrets / overrides (real credentials must never be committed)
appsettings.Development.json
appsettings.Local.json
appsettings.*.Local.json
secrets.json
.env
.env.*

# Private keys / certificates that may sit alongside the project
*.pem
*.key
*.pfx
*.p12

# .NET / NuGet
project.lock.json
*.nuget.props
*.nuget.targets
*.nupkg
*.snupkg
.packages/

# Rider / ReSharper
.idea/
*.DotSettings.user
_ReSharper*/

# Visual Studio
.vs/
*.user
*.userosscache
*.suo
*.sln.docstates
*.userprefs

# VS Code (keep launch.json/tasks.json/extensions.json/settings.json, ignore the rest)
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json

# Docker leftovers
.docker/

# OS junk
.DS_Store
Thumbs.db
